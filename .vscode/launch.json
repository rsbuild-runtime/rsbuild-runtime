{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Rsbuild",
      "port": 9230,
      "restart": true,
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "直接调试 Playground",
      // 使用绝对路径，确保万无一失
      "program": "${workspaceFolder}/scripts/debug.js",
      "args": ["rsbuild", "dev"],
      "cwd": "${workspaceFolder}/playground",
      "console": "integratedTerminal",
      "sourceMaps": true,
      // 加上这一行，防止因为子进程启动慢而断开
      "timeout": 30000
    }
  ]
}
