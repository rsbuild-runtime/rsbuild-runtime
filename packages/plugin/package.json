{
  "name": "rsbuild-plugin-runtime",
  "version": "1.0.0",
  "description": "基于静态编排与代码生成的 Rsbuild 运行时框架插件",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "dependencies": {
    "@rsbuild-runtime/core": "workspace:*",
    "jiti": "^2.1.2",
    "fs-extra": "^11.2.0",
    "lodash-es": "^4.17.21"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=1.0.0"
  },
  "devDependencies": {
    "@rsbuild-runtime/core": "workspace:*",
    "@rsbuild/core": "^1.7.3",
    "@rslib/core": "^0.19.6",
    "@rstest/adapter-rslib": "^0.2.0",
    "@rstest/core": "^0.8.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.13",
    "@umijs/types": "^3.5.43",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
