{
  "name": "@rsbuild-runtime/core",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rsbuild/core": "^1.7.3",
    "@rslib/core": "^0.19.6",
    "@rstest/adapter-rslib": "^0.2.0",
    "@rstest/core": "^0.8.5",
    "@types/node": "^24.10.13",
    "@types/pacote": "^11.1.8",
    "@types/resolve": "^1.20.6",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pacote": "^21.5.0",
    "resolve": "^1.22.11",
    "semver": "^7.7.4"
  }
}
