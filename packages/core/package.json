    "lint": "eslint .",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.7.3",
    "@rslib/core": "^0.19.6",
    "@rstest/adapter-rslib": "^0.2.0",
    "@rstest/core": "^0.8.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.13",
    "typescript": "^5.9.3"
