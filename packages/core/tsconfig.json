{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "composite": true, // 必须开启，支持被引用
    "noEmit": false, // 必须改为 false，否则无法作为引用项
    "emitDeclarationOnly": true, // 关键：只产出类型定义文件，不产生 JS 文件
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist", // 产出到 dist 目录
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": ["src"]
}
